{
  "name": "valorant-rank-cli",
  "version": "1.0.0",
  "description": "CLI tool to display your current Valorant rank, RR, and ELO",
  "main": "build/index.js",
  "type": "module",
  "bin": {
    "valorant-rank": "build/index.js"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "prebuild": "rimraf dist build",
    "build": "tsc && esbuild build/index.js --bundle --platform=node --format=cjs --outfile=dist/bundle.cjs && pkg dist/bundle.cjs --targets node18-win-x64 --output dist/valorant-rank-cli.exe",
    "postbuild": "rimraf build dist/bundle.cjs",
    "lint": "biome check src/",
    "lint:fix": "biome check src/ --write",
    "format": "biome format src/ --write",
    "format:check": "biome format src/",
    "typecheck": "tsc --noEmit",
    "validate": "biome check src/ && tsc --noEmit"
  },
  "pkg": {
    "assets": [],
    "targets": [
      "node18-win-x64"
    ],
    "outputPath": "dist"
  },
  "keywords": [
    "valorant",
    "rank",
    "elo",
    "cli",
    "riot"
  ],
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.6.2",
    "rimraf": "^6.1.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "@types/node": "^25.5.2",
    "esbuild": "^0.28.0",
    "pkg": "^5.8.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  }
}
