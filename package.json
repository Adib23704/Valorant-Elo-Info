{
  "name": "valorant-elo-info",
  "version": "1.1.0",
  "description": "Instantly check your Valorant rank, RR, and ELO from the command line",
  "author": "Adib23704",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Adib23704/valorant-elo-info.git"
  },
  "homepage": "https://github.com/Adib23704/valorant-elo-info#readme",
  "bugs": "https://github.com/Adib23704/valorant-elo-info/issues",
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "build": "node scripts/build.cjs",
    "lint": "biome check src/",
    "lint:fix": "biome check src/ --write",
    "format": "biome format src/ --write",
    "format:check": "biome format src/",
    "typecheck": "tsc --noEmit",
    "validate": "biome check src/ && tsc --noEmit"
  },
  "keywords": [
    "valorant",
    "valorant-rank",
    "valorant-elo",
    "ranked-rating",
    "riot-games",
    "riot-client",
    "mmr",
    "competitive",
    "tracker",
    "cli"
  ],
  "dependencies": {
    "chalk": "^5.6.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "@types/node": "^25.5.2",
    "esbuild": "^0.28.0",
    "pkg": "^5.8.1",
    "rcedit": "^5.0.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  },
  "packageManager": "pnpm@10.33.0"
}
